# 内部试用；所有密钥自行生成，禁止粘贴到交接文档。
PORT=3200
HOST_PORT=3200
# 数据库：sqlite(默认) | postgres；postgres 时使用 DATABASE_URL。
DB_DRIVER=sqlite
DATABASE_URL=
# Postgres 容器（docker compose）参数
PG_HOST_PORT=55434
PG_USER=ecom
PG_PASSWORD=
PG_DB=ecom_ai
JWT_SECRET=
JWT_EXPIRES=1d
ALLOW_REGISTRATION=false
SEED_DEFAULT_USERS=false
SEED_DEMO_DATA=false
ENABLE_SCHEDULER=false
# 空库首次创建管理员时临时启用 SEED_DEFAULT_USERS，完成后关闭。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TRUST_PROXY=1
# 本地留空（不发送跨域许可）；部署时填实际 HTTPS origin。
CORS_ORIGIN=
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-pro
AI_REASONING_EFFORT=none
AI_FALLBACK_MODEL=
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_IMAGE_MODEL=doubao-seedream-4-5-251128
AI_IMAGE_WATERMARK=false
AI_IMAGE_MAX_CONCURRENCY=3
SUGGEST_CONCURRENCY=4
# 建议引擎：低于该置信度的可执行建议被剔除（0-1，no_change 始终保留）
SUGGEST_MIN_CONFIDENCE=0.6
# 知识库分块（字符）与检索
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=80
# 多 Provider 优先级与故障转移（JSON）；留空则回退上面的单源 AI_* 配置。
# 密钥用 apiKeyEnv 引用环境变量名，避免明文写入。
# 示例：[{"id":"deepseek","priority":1,"caps":["chat"],"baseUrl":"https://api.deepseek.com/v1","apiKeyEnv":"AI_API_KEY","model":"deepseek-v4-pro","fallbackModel":"deepseek-flash"},{"id":"volcengine","priority":2,"caps":["chat","image"],"baseUrl":"https://ark.cn-beijing.volces.com/api/v3","apiKeyEnv":"AI_IMAGE_API_KEY","model":"doubao-pro-32k","imageModel":"doubao-seedream-4-5-251128"}]
AI_PROVIDERS=
# 队列（BullMQ）：true 时采集/通知走队列，否则同步执行
QUEUE_ENABLED=false
# 采集并发（50+ 店铺时避免串行线性增长）
COLLECT_CONCURRENCY=5
# 执行并发（按店铺分组并发，店铺内串行）
EXEC_CONCURRENCY=4
# 采集失败最大重试次数（回调失败自动重试）
COLLECT_MAX_RETRIES=2
RPA_MOCK_MODE=true
RPA_CALLBACK_TOKEN=
# 影刀 OpenAPI（真实模式）：按任务类型配置应用 ID
RPA_API_BASE=https://openapi.yingdao.com
RPA_APP_SECRET=
RPA_APP_ID_DAILY_REPORT=
RPA_APP_ID_AD_CAMPAIGNS=
RPA_APP_ID_EXECUTE=
# 执行器：manual(默认，人工执行清单+回填) | rpa(自动执行)
# 自动执行默认关闭；开启需同时设 EXECUTOR_DRIVER=rpa 与 AUTO_EXECUTE_ENABLED=true
EXECUTOR_DRIVER=manual
AUTO_EXECUTE_ENABLED=false
# 自动执行风控：倒计时(秒)、失败熔断阈值、熔断冷却(分钟)、单次调价幅度上限
AUTO_EXECUTE_COUNTDOWN_SEC=60
AUTO_EXECUTE_FAILURE_THRESHOLD=5
AUTO_EXECUTE_COOLDOWN_MIN=30
MAX_ADJUST_RATIO=0.3
# 邮件通知（SMTP）：配置后 email 渠道可用；短信渠道为桩，待接入服务商
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=电商 AI 平台
# 通知模式：fanout=所有启用渠道都发（默认）；failover=按 webhook→邮件→短信 顺序，成功即止
NOTIFY_MODE=fanout
# Redis：限流/会话缓存/调度分布式锁。生产 REDIS_REQUIRED 默认 true（起不来即失败）
REDIS_URL=
REDIS_REQUIRED=
SCHEDULER_SINGLE_INSTANCE=
# 平台超管（可选，一次性创建后关闭）
SEED_SUPERADMIN=false
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
SUPERADMIN_EMAIL=
# 对象存储：local(默认) | s3（MinIO/云 OSS/S3，S3 协议）
STORAGE_DRIVER=local
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ecom-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# MinIO 容器（docker compose）
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# 熔断（ProviderRegistry）
CB_THRESHOLD=5
CB_COOLDOWN_MS=60000
# 可选：数据目录与文件路径。留空用默认（./data、./uploads）；生产 Compose 固定为容器内路径。
DATA_DIR=
DB_PATH=
UPLOAD_DIR=
# 日志：结构化 JSON + 大小轮转（LOG_CONSOLE=true 时全部级别也输出到控制台）
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=5
LOG_CONSOLE=false
# 队列 worker 并发（每队列）
QUEUE_CONCURRENCY=5
# 优雅停机超时（毫秒）
SHUTDOWN_TIMEOUT_MS=10000
# 备份异地副本目录（设置后 backup 完成会复制一份到该目录）
OFFSITE_BACKUP_DIR=
